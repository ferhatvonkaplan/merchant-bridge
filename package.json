{
  "name": "merchant-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:serve": "python3 scripts/serve-preview.py",
    "test": "tsx --test src/lib/*.test.ts",
    "test:preview": "python3 -m unittest discover -s tests -p 'test_preview_server.py' -v",
    "test:deploy": "python3 -m unittest discover -s tests -p 'test_deploy_aws.py' -v",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run test:preview && npm run test:deploy && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  }
}
